# ============================================================
# MONAD AURA — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control!
# ============================================================

# Deployment wallet private key (used by Hardhat/scripts only)
# Generate a FRESH wallet for deployment — do NOT use your main wallet
PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY_HERE

# Deployed contract address (set after running deploy script)
VITE_CONTRACT_ADDRESS=0xYOUR_CONTRACT_ADDRESS_HERE
